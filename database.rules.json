{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": true,
      "$uid": {
        ".read": true,
        ".write": "auth != null && (auth.token.email === 'admin@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin' || (auth.uid === $uid && newData.child('role').val() != 'admin'))",
        ".validate": "newData.hasChildren(['id', 'name', 'email', 'role']) && newData.child('role').isString() && (newData.child('role').val() === 'candidate' || newData.child('role').val() === 'recruiter' || newData.child('role').val() === 'mentor' || newData.child('role').val() === 'instructor' || newData.child('role').val() === 'admin')"
      }
    },

    "deleted_users": {
      ".read": true,
      "$uid": {
        ".read": true,
        ".write": "auth != null && (auth.token.email === 'admin@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "resumes": {
      ".read": true,
      ".write": true
    },

    "applications": {
      ".read": true,
      ".write": true
    },

    "jobs": {
      ".read": true,
      ".write": true
    },

    "mentorship_services": {
      ".read": true,
      "$serviceId": {
        ".write": "auth != null && (auth.token.email === 'admin@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.uid === data.child('mentorId').val() || auth.uid === newData.child('mentorId').val())",
        ".validate": "newData.hasChildren(['title', 'mentorId', 'price', 'category'])"
      }
    },

    "bookings": {
      ".read": "auth != null",
      "$bookingId": {
        ".write": "auth != null && (auth.token.email === 'admin@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.uid === data.child('candidateId').val() || auth.uid === newData.child('candidateId').val() || auth.uid === data.child('mentorId').val() || auth.uid === newData.child('mentorId').val())"
      }
    },

    "courses": {
      ".read": true,
      "$courseId": {
        ".write": "auth != null && (auth.token.email === 'admin@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.uid === data.child('instructorId').val() || auth.uid === newData.child('instructorId').val())",
        ".validate": "newData.hasChildren(['title', 'instructorName', 'category'])"
      }
    },

    "chats": {
      ".read": "auth != null",
      "$roomId": {
        ".write": "auth != null && (auth.token.email === 'admin@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin' || newData.child('participantIds').hasChild(auth.uid))"
      }
    },

    "messages": {
      ".read": "auth != null",
      "$roomId": {
        ".write": "auth != null && (auth.token.email === 'admin@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$messageId": {
          ".write": "auth != null && auth.uid === newData.child('senderId').val()"
        }
      }
    },

    "broadcast_notifications": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'admin@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    },

    "push_notifications_queue": {
      ".read": "auth != null && (auth.token.email === 'admin@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
      ".write": "auth != null && (auth.token.email === 'admin@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    },

    "fcm_tokens": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "app_config": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'admin@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    },

    "candidate_notifications": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'admin@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null"
      }
    },

    "user_notifications": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'admin@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null"
      }
    }
  }
}