{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth != null && (auth.token.email === 'admin@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'admin@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.token.email === 'admin@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin' || (auth.uid === $uid && (!data.exists() || data.child('role').val() === newData.child('role').val())))",
        ".validate": "newData.hasChildren(['id', 'name', 'email', 'role']) && newData.child('role').isString() && (newData.child('role').val() === 'candidate' || newData.child('role').val() === 'recruiter' || newData.child('role').val() === 'mentor' || newData.child('role').val() === 'instructor' || newData.child('role').val() === 'admin')",
        "avatarUrl": { ".validate": "newData.isString()" },
        "avatarIconKey": { ".validate": "newData.isString()" },
        "skills": {
          "$skill": { ".validate": "newData.isString()" }
        }
      }
    },

    "deleted_users": {
      ".read": "auth != null && (auth.token.email === 'admin@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'admin@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.token.email === 'admin@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "resumes": {
      ".read": "auth != null",
      "$resumeId": {
        ".write": "auth != null && (auth.token.email === 'admin@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.uid === newData.child('userId').val())"
      }
    },

    "applications": {
      ".read": "auth != null",
      "$appId": {
        ".write": "auth != null && (auth.token.email === 'admin@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.uid === newData.child('candidateId').val())"
      }
    },

    "jobs": {
      ".read": "auth != null",
      "$jobId": {
        ".write": "auth != null && (auth.token.email === 'admin@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.uid === newData.child('recruiterId').val())",
        ".validate": "newData.hasChildren(['title', 'companyName', 'location', 'recruiterId'])"
      }
    },

    "mentorship_services": {
      ".read": "auth != null",
      "$serviceId": {
        ".write": "auth != null && (auth.token.email === 'admin@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.uid === newData.child('mentorId').val())",
        ".validate": "newData.hasChildren(['title', 'mentorId', 'price', 'category'])"
      }
    },

    "bookings": {
      ".read": "auth != null",
      "$bookingId": {
        ".write": "auth != null && (auth.token.email === 'admin@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.uid === newData.child('candidateId').val() || auth.uid === newData.child('mentorId').val())"
      }
    },

    "courses": {
      ".read": "auth != null",
      "$courseId": {
        ".write": "auth != null && (auth.token.email === 'admin@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "newData.hasChildren(['title', 'instructorName', 'category'])"
      }
    },

    "chats": {
      ".read": "auth != null",
      "$roomId": {
        ".write": "auth != null && (auth.token.email === 'admin@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin' || newData.child('participantIds').hasChild(auth.uid))"
      }
    },

    "messages": {
      ".read": "auth != null",
      "$roomId": {
        ".write": "auth != null && (auth.token.email === 'admin@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$messageId": {
          ".write": "auth != null && auth.uid === newData.child('senderId').val()"
        }
      }
    }
  }
}